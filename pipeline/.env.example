# Chave da API do Portal Brasileiro de Dados Abertos.
# Gratuita: entre em https://dados.gov.br com conta gov.br, abra "Minha conta"
# e gere a chave de API.
#
# O pipeline lê primeiro o .env deste diretório e depois o da raiz do projeto,
# então basta preencher em um dos dois.
DADOS_GOV_API_KEY=

# Endereço base da API. Só mude para apontar para um dublê em teste.
# DADOS_GOV_API_URL=https://dados.gov.br/dados/api/publico
