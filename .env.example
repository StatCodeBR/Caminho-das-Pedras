# Chave da API do Portal Brasileiro de Dados Abertos
# Obtenha em https://dados.gov.br apos criar conta via gov.br
DADOS_GOV_API_KEY=

# Chave da API da Anthropic, usada no enriquecimento offline e na resposta
ANTHROPIC_API_KEY=

# Chave do Context7, opcional; sem ela o limite de uso e menor
CONTEXT7_API_KEY=

# contato usado no User-Agent
# Contato no User-Agent do verificador de saúde. Vai para os servidores dos
# órgãos: se alguém estranhar o tráfego, tem a quem perguntar antes de bloquear.
SAUDE_CONTATO=

# Chave da Cohere, provedor padrao do enriquecimento offline
# Gerada em https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# --- serviço de resposta (api/) ------------------------------------------

# Caminho do dados.db que a API lê, sempre em modo somente leitura
BANCO=

# 1 responde com texto pré-gravado, sem chamar modelo nem exigir credencial.
# Precisa de valor: vazio não é "desligado", é erro de conversão, e a api não sobe.
MODO_STUB=0

# Roteamento entre resposta por template e resposta redigida pelo modelo.
# Conservadores de propósito: servir template para pergunta ambígua entrega
# resposta confiante e errada, e gastar token à toa custa centavos.
#
# Normalmente deixe em branco, e melhor ainda: não defina. Os valores calibrados
# vivem em `api/app/configuracao.py`, junto da medição que os justifica, e o
# ambiente vence o padrão do código — definir aqui congela a calibração antiga.
# Defina apenas para sobrepor de propósito. Ficam comentados porque vazio não é
# o mesmo que ausente: o serviço não converte "" em número e não sobe, e copiar
# este arquivo para .env com as chaves vazias derrubaria a api.
#
# Os valores calibrados hoje, para referência:
# LIMIAR_TEMPLATE=35.0
# MARGEM_TEMPLATE=2.0
# LIMIAR_RELEVANCIA=12.0

# --- interface (web/) ----------------------------------------------------

# Endereço interno da API. O navegador nunca fala com ela direto: a rota de
# servidor do SvelteKit repassa o fluxo, para dispensar CORS e não expor a API.
API_URL=

# --- publicação (compose.yml) --------------------------------------------

# Domínio público. Só o web tem; a api fica na rede interna.
DOMINIO=

# URL pública completa. O adapter-node exige ORIGIN para validar o POST:
# sem isso, o envio da pergunta é recusado como falsificação de origem.
ORIGIN=

# --- contenção de consumo (mudança 10) -----------------------------------

# Teto global de chamadas ao modelo por dia UTC. Ao estourar, o serviço passa
# a responder por template; nenhuma requisição vira erro por causa do teto.
TETO_DIARIO_MODELO=400

# Limite por endereço, em janela deslizante. Ao estourar, 429 com Retry-After.
LIMITE_ORIGEM_MAXIMO=20
LIMITE_ORIGEM_JANELA=3600

# De onde o web lê o endereço do visitante. Com Cloudflare na frente do
# Traefik, use ADDRESS_HEADER=cf-connecting-ip, ou XFF_DEPTH=2 — senão o
# limite passa a contar a Cloudflare como origem única de todo o tráfego.
ADDRESS_HEADER=x-forwarded-for
XFF_DEPTH=1

# --- publicação do catálogo ----------------------------------------------

# Token do GitHub com permissão de escrita em releases, usado só por
# `just catalogo-publica`. Nunca entra em imagem nem em log: o publicador passa
# a credencial ao curl pela entrada padrão, e não por argumento, porque
# cabeçalho em argv aparece no `ps` para qualquer processo da máquina.
#
# O download do catálogo durante o build NÃO usa token: o repositório é
# público e o asset da release é aberto.
GITHUB_TOKEN=

# --- ritmo da coleta -----------------------------------------------------

# Requisições simultâneas ao portal. O padrão é 2: com 10, o dados.gov.br
# cortou o acesso após 245 páginas em quatro minutos e passou a responder 405
# a qualquer pedido, inclusive à página 1.
COLETA_CONCORRENCIA=2

# Segundos de pausa entre páginas, além do tempo da própria requisição.
COLETA_PAUSA_PAGINA=1.5
