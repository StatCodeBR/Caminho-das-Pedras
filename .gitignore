# Nix / direnv
result
result-*
.direnv/

# Python
.venv/
**/.venv/
__pycache__/
*.pyc

# Node
node_modules/
**/node_modules/
.svelte-kit/
build/
.npm/

# Segredos
.env
**/.env

# Artefatos do pipeline
pipeline/bruto/
pipeline/cache/
pipeline/quarentena.jsonl
pipeline/dados/*.db
# Exceção deliberada: o dados.db da amostra é versionado porque o Dokploy
# constrói a imagem da api a partir do clone do repositório, e o Dockerfile
# copia o banco para dentro dela. São 4,8 MB com os 505 conjuntos.
#
# Isto tem teto: o catálogo completo dá cerca de 155 MB, acima do limite de
# 100 MB por arquivo do GitHub. Antes da coleta completa, trocar por imagem
# publicada em registry — o compose passa a usar `image:` em vez de `build:`.
!pipeline/dados/dados.db
pipeline/dados/*.npy

# Modelos baixados
.cache/fastembed/

# Claude Code (local, não compartilhado)
.claude/settings.local.json
docs/historico claude/

# Rascunhos e travas do LibreOffice na curadoria da avaliação
*.bak
.~lock.*#

# SvelteKit
web/node_modules/
web/.svelte-kit/
web/build/

# Estado de execução da contenção: contador de gasto e janela por origem.
# É produzido pelo serviço rodando, difere entre máquinas e não descreve
# o projeto. Em produção mora num volume, não no repositório.
api/estado/
