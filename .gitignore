# Nix / direnv
result
result-*
.direnv/

# Python
.venv/
**/.venv/
__pycache__/
*.pyc

# Node
node_modules/
**/node_modules/
.svelte-kit/
build/
.npm/

# Segredos
.env
**/.env

# Artefatos do pipeline
pipeline/bruto/
pipeline/cache/
pipeline/quarentena.jsonl
# Artefatos gerados pelo pipeline. Banco de dados gerado não é código-fonte:
# é resultado de uma execução, e o Git guarda cada versão inteira para sempre,
# porque SQLite reorganiza as páginas a cada escrita e não delta-comprime.
#
# O catálogo é distribuído como asset de release, comprimido. O repositório
# guarda só a soma de verificação e o manifesto; a imagem baixa e confere.
pipeline/dados/*.db
pipeline/dados/*.db-journal
pipeline/dados/*.db-wal
pipeline/dados/*.db-shm
pipeline/dados/*.npy
# A lista de identificadores dos vetores. Gerada junto do `.npy`, na mesma
# execução, e amarrada a ele por soma: versionar só um dos dois seria pior do
# que não versionar nenhum.
pipeline/dados/vectors.json
pipeline/dados/*.tmp
# O artefato comprimido que vai para a release. Ele é o que *não* deve estar
# aqui: versioná-lo seria exatamente o problema que a release resolve.
pipeline/dados/*.gz

# Modelos baixados. Com barra no meio, o padrão ficaria ancorado na raiz — e o
# FASTEMBED_CACHE_PATH é relativo ao diretório de onde se roda: rodando da api/,
# o modelo de 470 MB cai em api/.cache/ e escaparia do .gitignore.
**/.cache/fastembed/

# Claude Code (local, não compartilhado)
.claude/settings.local.json
docs/historico claude/

# Rascunhos e travas do LibreOffice na curadoria da avaliação
*.bak
.~lock.*#

# SvelteKit
web/node_modules/
web/.svelte-kit/
web/build/

# Estado de execução da contenção: contador de gasto e janela por origem.
# É produzido pelo serviço rodando, difere entre máquinas e não descreve
# o projeto. Em produção mora num volume, não no repositório.
api/estado/
